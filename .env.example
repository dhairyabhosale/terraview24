# Copy to .env.local for local development. NEVER commit a filled in copy:
# .env and .env.* are gitignored, with .env.example the only exception.
#
# Nothing in this file reaches the client bundle. If the frontend ever needs a
# key, the design is wrong. See docs/ARCHITECTURE.md section 8.

# --- Frontend, build time, PUBLIC ------------------------------------------
# These are repository coordinates, not credentials: they are the address of a
# public branch. Set in Vercel as project environment variables. They are
# VITE_ prefixed, so they are baked into the bundle at BUILD time and changing
# one needs a redeploy, not just a refresh.
VITE_DATA_OWNER=dhairyabhosale
VITE_DATA_REPO=terraview24

# --- Pipeline secrets, GitHub repo secrets in production -------------------
# Obtain each one per the credentials table at the end of
# docs/DATA_SOURCES.md. None of these is needed for Phase 0 except FIRMS,
# which Phase 0a needs in order to settle the DAY_RANGE ceiling.

# NASA FIRMS. Self service and immediate at
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Global Forest Watch data API. Three step: sign-up, token, apikey. Sent as an
# x-api-key header. Expires after about one year, silently.
GFW_API_KEY=

# OpenAQ v3. Sent as an X-API-Key header. v2 is retired.
OPENAQ_API_KEY=

# Global Fishing Watch. Max 5 tokens per user. Rate limit breaches are hard
# blocks of 24 hours (daily) or 30 days (monthly), so cap volume in code.
GFW_FISHING_TOKEN=

# IUCN Red List v4. Bearer token in the Authorization header. v3 is defunct.
IUCN_API_TOKEN=

# Protected Planet. Optional: WDPA is also reachable through the GFW data API
# and as a bulk download, which is the route Tier 0 uses.
PROTECTED_PLANET_TOKEN=

# Copernicus Data Space. Optional fallback for Sentinel products only;
# Planetary Computer is the primary route and needs no credential at all.
# The client secret expires every 90 days with no rotation API.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- NOT in this file ------------------------------------------------------
# The trigger token lives ONLY as a Cloudflare Worker secret, set with
# `wrangler secret put GITHUB_TOKEN`. It is never in the repository, never in
# an env file, and never in the client bundle. Fine grained PAT, Actions:
# write on this repo only, 90 day expiry.
